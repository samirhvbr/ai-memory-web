# ─────────────────────────────────────────────────────────────────────────────
# ai-memory-web — see docs/runbook.md §3 for what each of these means.
# Copy to .env, then: php artisan key:generate
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="ai-memory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── The ai-memory index (read-only) ──────────────────────────────────────────
# Absolute path of memory.sqlite ON THIS HOST. This app has to run on the same
# machine as ai-memory. Find the real path:
#   ls -l /opt/ai-memory/data/db/memory.sqlite      # 2.x native install
#   systemctl cat ai-memory | grep -- --data-dir    # whatever the unit says
#   docker volume inspect ai-memory-data            # 1.x, then + /db/memory.sqlite
#
# Read permission on the FILE is not enough — the web user also needs WRITE on
# the DIRECTORY. See docs/permissions.md before you conclude it is broken.
AI_MEMORY_SQLITE_PATH=/opt/ai-memory/data/db/memory.sqlite

# Display timezone for timestamps (ai-memory stores UTC microseconds).
AI_MEMORY_TIMEZONE=UTC

# Days shown in the activity charts, and rows per page in the listings.
AI_MEMORY_CHART_DAYS=30
AI_MEMORY_PER_PAGE=50

# Name in the header — handy when two installs are open at once.
AI_MEMORY_BRAND=ai-memory

# ── This app's OWN database ──────────────────────────────────────────────────
# Users, sessions and the durable snapshot history. Nothing to do with
# ai-memory. SQLite by default: `touch database/database.sqlite`.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ai_memory_web
# DB_USERNAME=
# DB_PASSWORD=

# ── Framework ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# No mail flow in this app: there is no sign-up and no password reset.
MAIL_MAILER=log
